FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=10000
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip && python -m pip install --no-cache-dir -r /app/requirements.txt
COPY live_api/app.py /app/app.py
COPY scripts/research_core.py /app/research_core.py
COPY data/reconciliation/nifty50_official_daily.csv /app/data/reconciliation/nifty50_official_daily.csv
COPY data/reconciliation/expiry_verification.csv /app/data/reconciliation/expiry_verification.csv
EXPOSE 10000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "10000"]
